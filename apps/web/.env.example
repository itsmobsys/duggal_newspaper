# ---------------------------------------------------------------------------
# Duggal Badmosh Daily - website environment (apps/web/.env.local)
# Copy to `.env.local` for local development. NEVER commit real values.
#
# On Vercel, set these in Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Public pages read Turso directly (fast, no API cold start).
# Local dev: the same file the API writes to (relative to apps/web).
TURSO_DATABASE_URL=file:../../data/duggal.db
# Production (Turso): libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# --- Render API -------------------------------------------------------------
# Base URL of the Fastify API, no trailing slash.
API_BASE_URL=http://localhost:8080

# Shared secret used to sign website -> API requests.
# MUST be byte-identical to SERVICE_SECRET on the Render API service.
SERVICE_SECRET=

# --- Site -------------------------------------------------------------------
# Canonical public URL, no trailing slash. Used for canonical tags, sitemap,
# RSS and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Discord login ----------------------------------------------------------
# Create an application at https://discord.com/developers/applications and add
# <NEXT_PUBLIC_SITE_URL>/api/auth/discord/callback as a redirect URI.
# Scope requested is `identify` only: no email, friends or servers.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional; defaults to <NEXT_PUBLIC_SITE_URL>/api/auth/discord/callback.
DISCORD_REDIRECT_URI=

# --- Cache revalidation -----------------------------------------------------
# The API POSTs to <site>/api/revalidate after publishing.
# MUST be byte-identical to REVALIDATE_SECRET on the Render API service.
REVALIDATE_SECRET=

# --- Optional ---------------------------------------------------------------
# Public base URL of the photo bucket. Only used for documentation/previews;
# photo URLs are stored absolute in the database.
NEXT_PUBLIC_MEDIA_BASE_URL=

# ---------------------------------------------------------------------------
# Duggal Badmosh Daily - API environment (apps/api reads the repo-root .env)
# Copy this file to `.env` and fill in the blanks. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# "development" | "test" | "production"
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Public URL of the Next.js site (comma-separate multiple origins if needed).
WEB_ORIGIN=http://localhost:3000
# Public URL of this API. Browser photo uploads PUT directly to this URL.
API_PUBLIC_URL=http://localhost:8080

# --- Database ---------------------------------------------------------------
# Local development: relative to apps/api (and apps/web resolves the same path).
TURSO_DATABASE_URL=file:../../data/duggal.db
# Production (Turso): libsql://your-db.turso.io
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=

# --- NVIDIA Nemotron --------------------------------------------------------
# Server-only. Never expose this key to the browser or commit it.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AI_MAX_RPM=28
AI_TIMEOUT_MS=180000
AI_MAX_ATTEMPTS=5
AI_TEMPERATURE=0.9
AI_MAX_TOKENS=2600
# Extra completion tokens reserved for reasoning (Nemotron thinks before it
# writes). The request budget is AI_MAX_TOKENS + AI_REASONING_HEADROOM_TOKENS.
AI_REASONING_HEADROOM_TOKENS=6000
AI_JSON_MODE=true
AI_VISION=true
AI_VISION_MAX_IMAGES=3

# --- Shared secrets (REQUIRED in production, min 24 chars, all different) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_SECRET=
WORKER_TICK_TOKEN=
SESSION_PEPPER=

ADMIN_SESSION_TTL_HOURS=72

# --- Photo storage (Vercel Blob, Hobby plan) --------------------------------
# Create a Blob store in the Vercel dashboard and copy its read/write token.
# Tokens stay server-side; never expose them to the browser.
BLOB_READ_WRITE_TOKEN=
# Optional private store for untouched originals (recommended). Without it,
# originals fall back to the public store under an unguessable random suffix.
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Blob keys are immutable, so the CDN cache can be long. 31,536,000 = 1 year.
BLOB_CACHE_MAX_AGE_SECONDS=31536000

# Local-only fallback. Photos are written to disk and served from /media/*.
# Uploads return 503 until storage is configured.
ALLOW_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=../../.storage

# --- Submission limits ------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
MAX_IMAGES_PER_SUBMISSION=4
UPLOAD_TICKET_TTL_MINUTES=30

SITE_TIMEZONE=Asia/Kolkata

# --- Worker / queue ---------------------------------------------------------
# Render Free: set WORKER_ENABLED=false and use the GitHub Actions cron.
WORKER_ENABLED=true
WORKER_INTERVAL_MS=20000
WORKER_LEASE_MS=300000
WORKER_MAX_JOBS_PER_TICK=4
WORKER_BUDGET_MS=90000
TRUST_PROXY=true

# --- Next.js cache invalidation (optional but recommended) ------------------
REVALIDATE_URL=https://your-site.vercel.app/api/revalidate
REVALIDATE_SECRET=

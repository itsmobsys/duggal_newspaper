# Normalise line endings so Windows and Unix checkouts agree.
* text=auto eol=lf

# Windows-only tooling
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Keep lockfiles diff-friendly
package-lock.json text eol=lf
